# Loaded automatically by Vite for `vite build --mode dev-preview` (see
# package.json's deploy:dev script), on top of .env.local. Only VITE_APP_URL
# needs to differ — same Supabase project for dev and prod, so
# VITE_SUPABASE_URL/ANON_KEY come from .env.local as usual.
#
# Real, publicly reachable HTTPS URL required (not localhost) — this becomes
# the base for auth redirect links (invite/reset) built while testing on the
# preview subdomain, same reasoning as VITE_APP_URL in .env.example.
VITE_APP_URL=https://dev.dolphintennis.com
